# ============================================================
# 复制为 .env 后按需修改：cp .env.example .env
# 所有配置均支持环境变量覆盖，未配置时使用代码内默认值
# ============================================================

# ---------------- 大模型（OpenAI 兼容协议）----------------
# 支持混元 / DeepSeek / 通义 / OpenAI / 本地 vLLM、Ollama 等任何 OpenAI 兼容服务
# 未配置 LLM_API_KEY 时，系统自动降级为本地 Mock 规则引擎，仍可完整跑通链路
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
# 注意：kimi 系列模型仅接受 temperature=1（0.1 会被拒）；其余模型建议保持 0.1 保证严谨
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
# 输出上限。注意：**推理模型（如 kimi-k2.6、DeepSeek-R1 等）的思考 token 与正文共享该额度**，
# 1024 会让正文写到一半就被截断（finish_reason=length）。用推理模型时请留足余量（建议 ≥4096）。
LLM_MAX_TOKENS=1024
# 是否关闭推理模型的「思考」阶段（供应商特定参数，经 extra_body 透传 thinking=disabled）。
# 默认 false（多数模型不支持该参数，传了会被 400 拒绝）。推理模型场景强烈建议置 true：
#   实测 kimi-k2.6 同一问句——思考开启首个可见字 11123ms / 思考关闭 1137ms，相差约 10 倍；
#   且思考会挤占 max_tokens 预算导致正文截断。
# ⚠️ 开关与 temperature 强耦合：关闭思考后 kimi-k2.6 只接受 temperature=0.6（开启时只接受 1.0）。
LLM_DISABLE_THINKING=false
# 流式请求是否携带 stream_options（含 token 用量统计）。多数 OpenAI 兼容服务不支持，
# 默认 false 以保证兼容；需要用量统计时置 true。
LLM_STREAM_USAGE=false

# ---------------- 启动健康检查 ----------------
# 启动时对真实大模型做一次 ping 健康检查（默认 false：把配额留给真实对话）
LLM_HEALTH_CHECK=false

# 常用服务示例（取消注释即可切换）：
# 腾讯混元  LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1   LLM_MODEL_NAME=hy3-preview
# DeepSeek  LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL_NAME=deepseek-chat
# 通义千问  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL_NAME=qwen-plus
# 本地 Ollama  LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL_NAME=qwen2.5:7b

# ---------------- 多 Agent 协作（路由 / 闲聊 / 简单 RAG / 复杂 RAG / 工具） ----------------
# 架构与路由规则见 docs/multi-agent-architecture.md。
# 这一组都**不影响正确性**，只影响成本与延迟（拿不准就别动）。
#
# 工具 Agent 最多几轮决策。默认 3，覆盖规格要求的三种情形：
#   ① 一次信息收集（可并行发多个调用）；② 链式调用（先查工号再查假期）；
#   ③ 参数不合 schema 被拒绝后，在同一轮内自我纠正。
TOOL_AGENT_MAX_STEPS=3
# 复杂 RAG：拆出几个子问题（= 多几次检索，直接决定延迟与成本）
COMPLEX_RAG_MAX_SUBQUERIES=4
# 复杂 RAG：多次检索合并去重后，最多留几条交给 L4 生成（决定上下文长度）
COMPLEX_RAG_MAX_DOCS=8

# ---------------- 业务结构化数据（SQLite，仅只读） ----------------
# 3 个只读工具的取数来源。工具签名与 JSON Schema 见 docs/tool-json-schema.md。
# 首次使用需建库：PYTHONPATH=. .venv/bin/python scripts/seed_enterprise_db.py
SQLITE_DB_PATH=./data/enterprise.db
# 注：服务端**没有登录态**，工号只能来自用户原话或工具返回值（见 tool_agent 的
# GROUNDED_ARGS 与提示词第 1 条）。历史上这里有过 EMPLOYEE_IDENTITY_MAP
# （会话身份 → 工号映射），它随工单查询工具一起整条移除，不再需要配置。

# ---------------- Embedding 向量化 ----------------
# 默认复用上方 LLM 的 Key 与 BASE_URL 调用 /embeddings 接口；留空则回退本地哈希向量
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL_NAME=text-embedding-3-small
# 查询侧检索指令前缀：bge 系列模型需配置（如 bge-m3 需「为这个句子生成表示以用于检索相关文章：」），
# 非 bge 模型清空即可。代码不识别具体模型名，换模型时只需改这里。
EMBEDDING_QUERY_PREFIX=
LOCAL_EMBEDDING_DIM=1024

# ---------------- 向量库（在两个后端之间切换只改 VECTOR_DB_TYPE）----------------
# 可选值（写错会直接报错，不会静默退回内存库；大小写与首尾空格会自动忽略）：
#   memory：零依赖内存库（带本地持久化，默认，万级以内）
#   chroma：单机嵌入式向量库（十万级）
#   milvus：分布式向量库（百万级以上，支持标量过滤与多租户）
#
# 用 chroma / milvus 前先装客户端（memory 无需任何额外依赖）：
#   pip install -r requirements-vector.txt
# 装完、配好之后，用这条命令确认「连得上、写不进得去、查得到」：
#   python scripts/check_vector_db.py            # 按本文件配置检查
#   python scripts/check_vector_db.py --type milvus   # 临时试某个后端，不改本文件
VECTOR_DB_TYPE=memory
CHROMA_PERSIST_DIR=./vector_store
COLLECTION_NAME=enterprise_knowledge

# Docker 专用：镜像里是否安装向量库客户端（chromadb / pymilvus，约 +120MB）。
# 默认 0（memory 后端不需要，镜像保持精简）；用 chroma / milvus 时须设为 1，
# 否则容器内缺包会降级为内存库。改后需重新构建：docker compose up -d --build
WITH_VECTOR_CLIENTS=0

# 严格模式。false（默认）：配了 chroma/milvus 却连不上时，服务照常启动、
# 自动降级为内存库（并在启动日志里打 ERROR 告警）。true：连不上直接拒绝启动。
# 生产环境建议 true —— 否则数据会被悄悄写进本地内存库，而你以为在用 Milvus。
VECTOR_DB_STRICT=false

# ---- Milvus（仅 VECTOR_DB_TYPE=milvus 时生效）----
# 本机直连：http://localhost:19530
# docker compose：用服务名 http://milvus:19530（并加 --profile milvus 起三容器）
MILVUS_URI=http://localhost:19530
# 本地免鉴权部署留空；Zilliz Cloud 等托管服务填 "<user>:<password>" 或 API Key
MILVUS_TOKEN=
# 集合名，默认复用 COLLECTION_NAME（enterprise_knowledge）
MILVUS_COLLECTION=
# 向量维度：0 = 首次写入时按向量长度自动推断（推荐）
# 换 embedding 模型时无需改；显式指定则会与已有集合做一致性校验
MILVUS_DIM=0
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# ---------------- Redis 会话缓存 ----------------
# 不可用时自动降级为进程内内存缓存，无需强依赖
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------- 检索与对话参数 ----------------
SIMILARITY_TOP_K=5
# 注意：阈值与 embedding 类型强相关。神经向量建议 0.30；本地哈希向量建议 0.08
# 留空则按 embedding 模式自动选择
SCORE_THRESHOLD=
CHUNK_SIZE=300
CHUNK_OVERLAP=60
MAX_CHAT_HISTORY=10
SESSION_TTL=86400

# ---------------- 记忆系统（短期窗口 + 两阶段长期记忆） ----------------
MEMORY_ENABLED=true
# 短期记忆：注入 prompt 的最近轮数 + 字符预算（两道约束同时生效，取更严的那个）
SHORT_TERM_WINDOW=6
SHORT_TERM_MAX_CHARS=2000
# 整理（Consolidator）：单次归档至少要压缩多少条消息才值得调一次模型；
# 尾部留几条暂不归档。约每 (阈值 + 尾部) 条新消息触发一次
CONSOLIDATE_ENABLED=true
CONSOLIDATE_THRESHOLD=10
CONSOLIDATE_KEEP_TAIL=4
# 蒸馏（Dream）：归档攒够一批即自动沉淀进 MEMORY.md / USER.md；
# 也可随时 POST /memory/{user_id}/dream 手动触发
DREAM_ENABLED=true
DREAM_BATCH_SIZE=5
MAX_HISTORY_ENTRIES=1000
# 长期记忆注入 prompt 的字符上限（防止记忆膨胀挤占检索上下文）
LONG_TERM_MAX_CHARS=1500

# ---------------- Rerank 精排（可选） ----------------
# cross-encoder 二次评分重排，提升「该进 Top-K 却排后」的片段。需 pip install sentence-transformers
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=10

# ---------------- 可观测性（LangSmith，可选） ----------------
# 置 true 并填 Key 后，每次 LLM 调用自动上报 trace 到 LangSmith。需 pip install langsmith
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-enterprise-bot
# 自托管 LangSmith 时填写；留空走官方 SaaS
LANGSMITH_ENDPOINT=

# ---------------- 服务 ----------------
# 监听地址不在 .env 配置：由启动命令决定（Dockerfile 里是 uvicorn --host 0.0.0.0）。
APP_PORT=8001
DATA_DIR=./data
LOG_DIR=./logs

# ---------------- 切分策略 ----------------
# CHUNK_STRATEGY: structure（默认，结构感知）| recursive（递归字符切分）
#
# 推荐组合（= 线上当前配置，离线 A/B 实测跨章率 16.9% → 2.3%）：
#   CHUNK_STRATEGY=structure + CHUNK_CONTEXT_HEADER=true + CHUNK_ENRICH_METADATA=true
#
# ⚠️ 切换策略或改动下列任一开关后，**必须全量重建索引**：
#   chunk_id 是内容哈希，新旧策略产物 ID 不同，增量入库不会覆盖旧块而是残留，
#   导致新旧块混杂、检索结果自相矛盾。
#   PYTHONPATH=. .venv/bin/python -c "from app.rag.indexer import build_index; build_index()"
CHUNK_STRATEGY=structure
CHUNK_TARGET_CHARS=220
CHUNK_HARD_MAX_CHARS=340
CHUNK_MIN_CHARS=60
CHUNK_CONTEXT_HEADER=true
CHUNK_ENRICH_METADATA=true
CHUNK_FALLBACK_OVERLAP_RATIO=0.12
INDEX_MIN_CHUNK_CHARS=40
# 按文档灰度：仅列出的文件名走 CHUNK_STRATEGY，其余走 recursive（逗号分隔，留空=全部生效）
CHUNK_STRATEGY_SCOPE=
# 结构解析锚点（正则，"|" 分隔多个模式）
STRUCTURE_CHAPTER_PATTERNS=第[一二三四五六七八九十百]+章|^[一二三四五六七八九十]+、
STRUCTURE_SECTION_PATTERNS=^\d+\.\d+|^Q\d+[：:]
STRUCTURE_ITEM_PATTERNS=^\d+[、.]|^[（(]\d+[）)]
STRUCTURE_MD_PATTERNS=^#{1,6}\s
STRUCTURE_FLAT_FALLBACK=true
# ---------------- 父子双层索引（T6-1，已实现但默认关）----------------
# 检索用细粒度子块保证准，生成用父块保证上下文完整（small-to-big）。
# 父块存旁路 JSON 不进向量库 → 向量数量与 embedding 成本零增长。
#
# 当前真实语料实测：176 子块 → 95 父块（父子比 1.85x，父块均长 332 字）。
# 收益有限，故默认关闭。**开启触发条件**（满足任一再开）：
#   语料 ≥100 篇 / 单篇 >5000 字 / 「命中正确但答案不完整」案例 >20%
# 开启后需全量重建索引（父块随子块一起重建）。
PARENT_CHUNK_ENABLED=false
# 同章连续子块累计到此长度即切一个父块
PARENT_MAX_CHARS=1000
# 父块旁路存储路径（JSON，无需额外存储依赖）
PARENT_STORE_PATH=vector_store/parents.json

# ---------------- PDF 图片抽取（T6-2，默认关）----------------
# 默认关闭：企业 PDF 里多数图片是装饰性（logo/图标/分隔线/水印），
# 塞进文本反而污染切分与检索。仅当「图片内含关键信息」时开启
# （架构图、数据图表、扫描件）。
PDF_IMAGE_EXTRACTION=false
# 面积下限（pt²）：小于此值视为装饰元素直接丢弃。10000 pt² ≈ 100×100 pt。
# 这是避免「图标污染文本」的关键闸门，调小前先看 artifacts/pdf_images/ 里实际抽到了什么。
PDF_IMAGE_MIN_AREA=10000
# 图片落盘目录（按文档名分子目录）
PDF_IMAGE_DIR=artifacts/pdf_images
# 渲染分辨率（OCR 越准但越慢越大）
PDF_IMAGE_DPI=150
# OCR 需要：pip install pytesseract + 系统 tesseract（中文另需 chi_sim 语言包）。
# 缺任一项都只会优雅降级为空 OCR 文本，不影响 PDF 文本抽取。
PDF_IMAGE_OCR=false

# ---------------- Dify 兼容接口（外部知识库）----------------
# 实现 Dify External Knowledge API，让 Dify 的知识检索节点直接调本项目，
# 文档无需再往 Dify 传一份。详见 docs/dify-integration.md
#
# 鉴权密钥：Dify 原样透传，**由本项目校验**。留空 = 端点拒绝服务（安全默认）。
DIFY_API_KEY=
# 期望的 knowledge_id：留空 = 接受任意非空值（单知识库场景）
DIFY_KNOWLEDGE_ID=
# 接入自检（不含密钥）：curl http://localhost:8001/dify/info

# ---------------- 来源访问控制（按用户隔离知识库）----------------
# 把 user_id 映射到「允许访问的文档来源白名单」。为空 = 不做来源限制。
# 键为 user_id；"*" 为默认规则；值为 fnmatch 模式列表，"*" 表示允许全部来源。
# 例：{"alice":["hr/*"],"bob":["finance/*"],"*":["*"]}
# 服务端解析对客户端传入的 allowed_sources 具有权威性（ACL 生效时以服务端为准）。
SOURCE_ACL=

# ============================================================
# 入站鉴权 / CORS / 限流
#
# 这三项直接决定服务能不能暴露到公网：
#   默认值都是「方便本地调试」，**部署到任何非本机环境前必须逐项确认**。
# ============================================================

# ---------------- 入站鉴权 ----------------
# 默认关闭以保证「零行为变化」。开启后，除 AUTH_EXEMPT_PATHS 外的所有请求
# 必须携带 X-API-Key: <key> 或 Authorization: Bearer <key>。
AUTH_ENABLED=false

# **开启 AUTH_ENABLED 后必须填写**。fail-closed 设计：开了鉴权却没配 Key 时，
# 所有请求一律被拒绝（而不是放行）——「开着鉴权但谁都能过」比不开更危险，
# 因为管理员会误以为已经防护过了。
# 生成一个强随机串：python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_API_KEY=

# 免鉴权路径（逗号分隔）。默认含存活探针与自带鉴权的端点：
#   /health、/            容器 HEALTHCHECK 依赖，不能加锁
#   /docs、/openapi.json  接口文档（不含数据）；从列表移除即可收紧
#   /dify/info            接入自检探针，只返回配置状态不含密钥
#   /retrieval、/dify/retrieval  由 Dify 模块用自己的 DIFY_API_KEY 校验
AUTH_EXEMPT_PATHS=/health,/,/docs,/redoc,/openapi.json,/dify/info,/retrieval,/dify/retrieval

# ---------------- CORS ----------------
# 允许的来源（逗号分隔）。默认通配以方便本地调试；
# **部署到具体域名时应显式列出**，如：CORS_ORIGINS=https://kb.example.com
# 来源为通配时凭据自动关闭（浏览器规范要求），故生产环境务必显式配置。
CORS_ORIGINS=*

# ---------------- 入站限流 ----------------
# 单 IP 每分钟请求上限（内存滑动窗口，进程内计数）。
# ⚠️ 注意不是「0 表示不限流」：填 0 会让 `len(window) >= 0` 恒真，**所有请求被拒**。
#    需要放开限流请填一个足够大的数（如 100000），不要填 0。
RATE_LIMIT_PER_MINUTE=20
